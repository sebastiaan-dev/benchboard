{
  "name": "benchboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "benchboard": "node packages/cli/bin/benchboard.ts",
    "dev": "pnpm --parallel --filter @benchboard/web --filter @benchboard/cli dev",
    "build": "pnpm --filter @benchboard/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "seed:demo": "BENCHBOARD_HOME=${BENCHBOARD_HOME:-/tmp/benchboard-demo} node scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~7.0.2",
    "@benchboard/core": "workspace:*"
  }
}
